# Copy to .env and fill in.
#
# Local dev:  docker compose up -d   then use the URL below as-is.
# Production: paste your Neon connection string (Vercel -> Project -> Settings -> Environment Variables).
DATABASE_URL="postgresql://leaflet:leaflet@localhost:5432/leaflet"

# Transactional email (verification + password reset). All OPTIONAL: with none
# set, emails are logged to the server console and links still work in dev. Set
# all three to send real mail in production.
# RESEND_API_KEY="re_..."                       # from resend.com
# MAIL_FROM="Leaflet <noreply@yourdomain.com>"
# APP_URL="https://leaflet-gules.vercel.app"    # base URL for links in emails
